# Copy this file to .env and fill in values from your Supabase project.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co

# Use a server-only secret key (or legacy service_role key), never a publishable key.
# Keep this key in this server .env file; do not put it in React or commit it.
SUPABASE_SECRET_KEY=YOUR_SERVER_ONLY_SECRET_KEY
